# 청첩장 환경변수 템플릿 — 실제 값은 .env.local 또는 Render 대시보드에 입력
# 이 파일은 Git에 커밋되며, 실제 키는 절대 여기 넣지 마세요.

# Naver Cloud Platform Maps - Client ID (네이버 지도 인증)
NEXT_PUBLIC_NCP_CLIENT_ID=

# Kakao Developers - JavaScript Key (카카오톡 공유)
NEXT_PUBLIC_KAKAO_KEY=

# 사이트 URL - 배포 도메인 (og:image 절대 경로 + 카카오 공유 링크)
# 로컬: http://localhost:3000
# 배포: https://your-app.onrender.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
